# Supabase — public browser credentials only.
#
# The anon/publishable key is designed to be public and is safe in browser code:
# every read and write it can perform is constrained by Row Level Security.
# It grants nothing on its own.
#
# NEVER put a service_role key in this file or any other file that reaches the
# browser. A static site has no server-side secret store, so privileged work is
# done inside Postgres by SECURITY DEFINER functions and RLS policies instead —
# those execute as the definer, not as this key.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Local UI preview -------------------------------------------------------
# When '1', pages render clearly-badged sample data so layouts can be reviewed
# without Supabase credentials. Two safety rules are enforced in code
# (assets/js/lms/config.ts):
#   1. It is force-disabled whenever VITE_SUPABASE_URL is a real project.
#   2. It is force-disabled unless the page is served from localhost.
# Never enable this for a production build.
VITE_PREVIEW_MODE=0
