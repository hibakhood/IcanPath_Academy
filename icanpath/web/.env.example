NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these names with NEXT_PUBLIC_ or VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel automatically uses its trusted IP header; set explicitly on other hosts.
CONTACT_TRUSTED_IP_HEADER=
CONTACT_IP_HASH_SECRET=
# Enforced by default. Use report-only only for temporary diagnostics.
CSP_MODE=enforce
# HTTPS-only origin, used to decide whether to emit HSTS.
PRODUCTION_SITE_URL=https://icanpathacademy.vercel.app
